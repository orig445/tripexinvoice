{
  // ─────────────────────────────────────────────────────────────────────────
  // TripEx.Api — PRODUCTION configuration TEMPLATE.
  //
  // 1. Copy this file to "appsettings.Production.json" (same folder as
  //    TripEx.Api.dll on the TAS host).
  // 2. Fill in every REPLACE_... value with the real one.
  // 3. NEVER commit the filled appsettings.Production.json (it is git-ignored).
  //
  // ASPNETCORE_ENVIRONMENT=Production (set in web.config) makes this file
  // override appsettings.json. Only the keys you put here override; the rest
  // fall back to appsettings.json.
  // The JSON config provider allows these // comments — safe to keep or remove.
  // ─────────────────────────────────────────────────────────────────────────

  "ConnectionStrings": {
    // TAS SQL Server. TrustServerCertificate=True unless you install a real cert.
    "DefaultConnection": "Server=TAS_SQL_HOST;Database=tripex;User Id=DB_USER;Password=DB_PASSWORD;TrustServerCertificate=True"
  },

  "Jwt": {
    // Also keys conversation resumption for any caller whose conversation id is not a GUID.
    // Such ids may be guessable (consecutive numbers, for example), so they are mapped
    // to a session through an HMAC under this secret rather than a plain hash anyone could
    // recompute. Two consequences worth knowing: rotating this restarts every such conversation
    // (the TAS widget sends real GUIDs and is unaffected), and leaving it empty makes a non-GUID
    // id start a fresh session instead of resuming one — safe, but Milo will look like it has no
    // memory on that channel. The startup log says so explicitly when it is missing.
    "Secret": "REPLACE_WITH_A_RANDOM_STRING_AT_LEAST_32_CHARS",
    "Issuer": "TripEx.Api",
    "Audience": "TripEx.Client",
    "ExpirationHours": 24
  },

  "ApiKey": {
    // Static key for server-to-server calls from TAS to this API.
    "Key": "REPLACE_WITH_A_STATIC_SERVER_TO_SERVER_KEY",
    "ClientName": "TripExClient"
  },

  "Oracle": {
    // Same OCI Generative AI account used by the OCR service.
    "ApiKey": "REPLACE_WITH_OCI_GENAI_KEY",
    "CompartmentId": "ocid1.compartment.oc1..REPLACE",
    "Region": "us-chicago-1",
    "Endpoint": "https://inference.generativeai.us-chicago-1.oci.oraclecloud.com/20231130/actions/v1/chat/completions",
    "Model": "google.gemini-2.0-flash",

    // Milo's fine-tuned custom model (trained on the Glassix support history).
    // Leave UseCustomModel false until CustomModelEndpoint/CustomModelId point at
    // a real, quality-validated hosting-cluster endpoint. Flipping it back to
    // false is the instant rollback — no redeploy, Milo just goes back to Gemini.
    // OCR/invoice-scan is unaffected either way (it never routes through this).
    "UseCustomModel": false,
    "CustomModelEndpoint": "",
    "CustomModelId": ""
  },

  "Support": {
    // Where Milo routes users on escalation (shown to the user / used by the UI).
    "Contact": "REPLACE_WITH_REAL_SUPPORT_EMAIL_OR_LINK"
  },

  "Milo": {
    // The status-list shortcut. When the user answers the fixed orientation question with
    // "travel & expense operations", the reply is the fixed status list either way, so the turn
    // is answered with a four-line prompt instead of the full 60,000-character page catalog
    // (measured at 39.3s / 3,561 thinking tokens before, the slowest turn in production).
    //
    // Set to "false" to turn it off WITHOUT a redeploy — restart the site and the turn goes back
    // through the full prompt, with the model deciding the intent again as it used to. The log
    // then prints "[CLARIFY-FAST] ... shortcut disabled by Milo:StatusListShortcut" on exactly
    // the turns it would have taken, so you can see the setting took effect. Anything other than
    // a literal "false" leaves it ON, so a typo cannot silently disable it.
    "StatusListShortcut": true,

    // The FIRST guiding question. When Milo can name the actual candidates it is torn between
    // ("the expense report for one trip" vs "a report across all flights"), it asks about THOSE
    // and the user picks in one step. Only when the question is too broad to name even two
    // candidates does it fall back to the fixed three-way orientation question (operations /
    // reports & data analysis / settings & management).
    //
    // Set to "false" to go back to always asking the fixed three-way question — config edit plus
    // a restart, no deploy. This is the most visible thing in the whole flow, which is why it has
    // its own switch. As above, only a literal "false" turns it off.
    "ModelAuthoredFirstClarify": true,

    // Development requests from the widget's opening menu. When the customer picks "Development
    // request" and then describes the change, that message is not answered by the model: Milo
    // replies with a fixed receipt, and the conversation becomes a Zoho ticket for the product team
    // (see the DevRequest* settings under "Zoho"). Anything the customer adds afterwards in the same
    // conversation gets a fixed "added to your request" line and goes onto the same ticket. Needs
    // Zoho to be enabled and configured; without it the choice is ignored.
    //
    // Set to "false" to turn it off WITHOUT a redeploy — restart the site, and the message is
    // answered like any other. The log prints "[DEV-REQUEST] ... menu choice ignored" whenever a
    // choice was not acted on, and "[DEV-REQUEST] ... submitted" when it was. As above, only a
    // literal "false" turns it off. (The widget has its own switch in config.js to hide the menu.)
    "DevRequests": true,

    // The sampling temperature of Milo's answers: a number from 0 to 2. The code default is 0.3,
    // the value Milo has always answered with, so this line is optional: it exists to try another
    // value without a publish. Lower means answers that vary less from one asking to the next
    // (0.1, say); 0 is the extreme, and if the logs then show "[OCI-PARSE] Truncated JSON" more
    // often, the model is stuck repeating itself and the value should go back up. Restart the site
    // after a change. Missing, invalid or out-of-range means 0.3, never a clamped value. The first
    // answer after a restart logs "[CHAT] temperature=..." once, so you can see which value took
    // effect. The temperature column of the chatbot_config table is NOT used any more; editing it
    // changes nothing.
    "Temperature": 0.3,

    // The /usage page: usage and estimated OCI cost per company and per user. It opens at
    // https://<server>/DEV_AI/usage#<this key> — after the #, so the key is in no request line and
    // no log. No key, or one shorter than 24 characters, means the page does not exist.
    // Make one with PowerShell:
    //   [guid]::NewGuid().ToString("N") + [guid]::NewGuid().ToString("N")
    // Anyone with the link can see the page, so keep it private.
    "UsagePageKey": "",

    // Price per million tokens, in US dollars, used for the cost on the /usage page. Output
    // includes the model's thinking tokens. Models left out use the built-in prices
    // (gemini-2.5-pro 1.25 / 10). Change a price only if Oracle's price list or your contract says so.
    "Pricing": {
      "google.gemini-2.5-pro": { "InputPerMillion": 1.25, "OutputPerMillion": 10.00 }
    },

    // Where Milo's page links point. When the widget knows the customer's own TAS — the site it
    // is embedded in plus the instance TAS sends as hostInstance — each link goes there, e.g.
    // https://taseu.combtas.com/Avt_Test/Main_Pagesv2/tasks.aspx. When it does not, links start
    // with PageLinksBaseUrl; left empty, with the baseUrl in Data/page-links.json (a QA instance).
    // Set it on a server that serves one environment. Restart the site after a change.
    "PageLinksBaseUrl": "",
    // The only sites a customer's link may point at: a host from this list or a subdomain of
    // one, https only. Comma-separated. Anything else falls back to the default above.
    "PageLinkHosts": "combtas.com"
  },

  "Zoho": {
    // Mirrors every customer conversation into ONE Zoho Desk ticket, so support can see what
    // Milo handled without it mixing into the human queue. Leave Enabled false until every
    // value below is real — with it false nothing is queued and no call is ever made, and
    // setting it back to false is the instant rollback (no redeploy).
    "Enabled": false,

    // ── OAuth: Self Client + refresh token (a one-time manual step) ──
    // 1. api-console.zoho.com → Add Client → SELF CLIENT → copy Client ID + Secret.
    // 2. Generate Code tab → scope:
    //      Desk.tickets.READ,Desk.tickets.CREATE,Desk.tickets.UPDATE,Desk.contacts.READ,Desk.contacts.CREATE,Desk.contacts.UPDATE,Desk.search.READ,Desk.basic.READ,Desk.agents.READ
    //    → pick the Desk portal → CREATE → copy the code (it expires in minutes).
    //    (Desk.tickets.READ is what every read of a ticket uses: the reopen's status check, the
    //    agent reply relay re-reading a reply, and the AgentReplyBackfill thread list. A token
    //    minted without it has every one of those refused.
    //    Desk.search.READ, Desk.contacts.READ and Desk.contacts.UPDATE are what LinkContactAccount
    //    uses to find or create the customer's company and put the contact under it. Without
    //    them tickets are created as usual and the log says "[ZOHO-ACCOUNT] ... needs the ... scope".
    //    Desk.agents.READ is only needed to look up an AssigneeId by name/email — drop it if
    //    you are not assigning tickets to a specific person.)
    // 3. POST {AccountsBaseUrl}/oauth/v2/token with client_id, client_secret,
    //    grant_type=authorization_code, code=<the code> → copy "refresh_token".
    // The refresh token does not expire; access tokens last an hour and refresh themselves.
    // AccountsBaseUrl must match your data centre: .com (US), .eu, .in, .com.au, .jp.
    "AccountsBaseUrl": "https://accounts.zoho.com",
    "ClientId": "REPLACE_WITH_ZOHO_SELF_CLIENT_ID",
    "ClientSecret": "REPLACE_WITH_ZOHO_SELF_CLIENT_SECRET",
    "RefreshToken": "REPLACE_WITH_ZOHO_REFRESH_TOKEN",

    // Desk sits on a DIFFERENT host per data centre, and it is NOT the api_domain the token
    // response returns. US: desk.zoho.com · EU: desk.zoho.eu · IN: desk.zoho.in ·
    // AU: desk.zoho.com.au · JP: desk.zoho.jp. A wrong host is a 401/404 on every call.
    "ApiBaseUrl": "https://desk.zoho.com",
    // Setup → Developer Space → API, or the orgId in any Desk URL.
    "OrgId": "REPLACE_WITH_ZOHO_DESK_ORG_ID",
    // STRONGLY recommended: a department of its own (e.g. "Milo / AI"). That is the only
    // separation that really keeps these out of the human queue — a tag or a custom field
    // still lands the ticket in the same list of work.
    "DepartmentId": "REPLACE_WITH_THE_AI_DEPARTMENT_ID",

    // How an AI-handled ticket is marked. Classification accepts custom values.
    "Classification": "AI Answer",
    "Channel": "Chat",
    "SubjectPrefix": "[Milo] ",
    // Milo handled it alone → created already closed, so it is a record and not someone's work.
    "AiHandledStatus": "Closed",
    // Milo gave up and handed over → the ticket is reopened into the queue.
    "EscalatedStatus": "Open",
    // Priority is what lets one queue hold both kinds of work without anyone filtering: a
    // conversation Milo handled alone is created Low, and escalating raises it to High in the
    // same call that reopens it (and never lowers it again). The same raise happens once when a
    // customer writes to an agent on a ticket Milo handled alone and it is still Closed at Low; a
    // ticket in any other state or at any other priority keeps what the agent gave it. Sort the
    // queue by priority and the tickets a person is actually waiting on sit at the top. Standard
    // Desk values are Low / Medium / High / Urgent — if this portal uses a custom priority list
    // that has no "Low", set either of these to "" and that field is simply left off the ticket.
    "AiHandledPriority": "Low",
    "EscalatedPriority": "High",
    // A development request from the widget's opening menu (see Milo:DevRequests) is work for the
    // product team, not a record of something Milo answered: it is created Open, with its own
    // classification and priority, and the subject reads "[Milo] [Development request] <the request>".
    // These four are the defaults and may be left out. If Desk refuses the create (this portal's
    // classification or priority list has no such value), it retries ONCE with the ordinary
    // Classification above and no priority, so the request is never lost — the log then says
    // "[ZOHO] Development request ticket create ... was refused" and names the setting to correct.
    // A blank status or classification means EscalatedStatus / Classification; a blank priority or
    // label is left off. Medium is deliberately not AiHandledPriority: when the customer answers an
    // agent's reply on a closed request ticket, it is reopened but not raised to High.
    "DevRequestStatus": "Open",
    "DevRequestClassification": "Feature",
    "DevRequestPriority": "Medium",
    "DevRequestSubjectLabel": "[Development request]",
    // Optional Desk custom-field API name to receive our chat session GUID, so a ticket can be
    // traced back to our own chat_messages. Create the field in Desk first, then put its API
    // name here (e.g. "cf_milo_session_id"). Leave empty to skip.
    "SessionIdField": "",

    // Optional Desk AGENT id (a long number as a string — not an email, not a ZUID). Every
    // mirrored ticket lands in that one person's queue, which is how a trial run works: one
    // owner reviews everything Milo handled before any of it reaches the real support queue.
    // Clearing this value and restarting the app pool ends the trial — tickets then follow the
    // department's own assignment rules. No code change either way.
    // Note: if the portal has its own assignment rules, Zoho can silently reassign the ticket;
    // the code reads the value back after creating and corrects it, and logs when it had to.
    "AssigneeId": "",

    // Zoho refuses to create a ticket without a contact, and needs a last name AND an email.
    // The widget does not send the customer's email yet, so until it does every ticket attaches
    // to this one address. Ask the TAS developer to add "customerEmail" to the widget payload —
    // this API already reads it — and tickets start attaching to the real customer with no
    // change here.
    "FallbackContactEmail": "REPLACE_WITH_A_REAL_MAILBOX_E_G_milo@tripex.io",
    "FallbackContactLastName": "Milo",

    "TimeoutSeconds": 15,

    // ── The way back: an agent's reply reaching the customer in Milo's own widget ──
    // Everything above sends conversations INTO Desk. These three bring an agent's answer back
    // out, so a customer who needed a human gets one in the same chat window instead of an email
    // address. Nothing below does anything until AgentRelayEnabled is true.
    //
    // SourceId — any UUID you generate once (e.g. PowerShell: [guid]::NewGuid()). It is sent as
    // the "sourceId" header on every write we make to Desk, and the SAME value goes in the
    // webhook's ignoreSourceId field. That pairing is what stops the loop: without it, Milo
    // mirroring the customer's own message into the ticket looks to us like an agent replying,
    // and it never stops. Set this BEFORE creating the webhook. Not a secret.
    "SourceId": "",

    // The relay's own off switch, separate from Enabled above because the risks differ: mirroring
    // a conversation into a ticket is a record nobody sees, while this puts text in front of a
    // customer. Leave false until the webhook is registered and tested. Setting it back to false
    // is the instant rollback — the endpoint keeps answering 200 (so Zoho does not disable or
    // delete the subscription) but nothing is fetched, stored or shown.
    "AgentRelayEnabled": false,

    // A long random string, at least 24 characters, that forms the last segment of the webhook
    // URL you give Zoho:
    //     https://<your-api-host>/api/zoho/desk/thread/<this value>
    // Zoho Desk supports NO authentication on a webhook ("Only open webhooks that are publicly
    // accessible and do not require authentication are supported"), so an unguessable URL is the
    // only gate at the door. It is not the only defence — the endpoint treats Zoho's payload as a
    // signal only and re-reads the actual reply over our own authenticated connection — but treat
    // this like a password anyway: it belongs in this file and nowhere else.
    "WebhookSecret": "",
    // ── Registering the webhook in Zoho (one-time, in the Desk UI) ──
    // Setup > Developer Space > Webhooks > New Webhook
    //   URL to Notify : https://<your-api-host>/api/zoho/desk/thread/<WebhookSecret>
    //   Module/Event  : Tickets → Outgoing threads   (Ticket_Thread_Add, direction "out")
    //   Department    : the Milo/AI department, so other teams' tickets never reach us
    //   Source ID     : the SAME UUID as SourceId above
    // Zoho sends a GET to the URL when you save and refuses to create the webhook unless it gets
    // a 200 — this API answers that automatically, so publish before you register.
    // Requires Desk Professional or above (Free and Standard allow zero webhooks).

    // ── The safety net under the webhook ──
    // The webhook is the ONLY way an agent's reply reaches the customer. If one call is lost (the
    // site mid-publish, a 5xx, Zoho disabling the subscription) that reply stays in Desk and the
    // customer never sees it. This setting runs a sweep every 10 minutes over conversations a
    // person is already answering (escalated, or already holding an agent reply) and active in
    // the last 24 hours, lists each ticket's threads, and relays any agent reply 5 minutes to 24
    // hours old that never arrived — through the same checks the webhook uses.
    //   "Off"     — the default, and what a missing key means. Nothing runs.
    //   "LogOnly" — the full sweep, but nothing is stored or shown: it logs
    //               "[ZOHO-BACKFILL] would relay ..." per reply it would recover, plus one
    //               "[ZOHO-BACKFILL] tickets=... eligible=... stored=..." summary per sweep. Run this
    //               for a few days first; eligible replies should almost all show as "stored" (the
    //               webhook got there), and there should be no 4xx on the /threads call.
    //   "On"      — recovered replies are shown to the customer. Each one logs a warning,
    //               "[ZOHO-BACKFILL] recovered ...".
    // Needs AgentRelayEnabled true and a valid WebhookSecret; with the relay off this does nothing,
    // whatever it says. Any other value (a typo, "true") means Off — the startup line
    // "[ZOHO] Agent reply relay is ON ... backfill=..." says which one took effect. Read once at
    // startup: recycle the app pool after changing it. "Off" plus a recycle is the rollback.
    // Cost: one Desk API call per such conversation per sweep (at most 25 per sweep, 3,600 a
    // day), plus one per reply actually recovered.
    "AgentReplyBackfill": "Off",

    // Puts each new ticket's contact under the customer's company (a Desk Account), so the company
    // shows in Contact Info. The company is read from the TAS address the customer works in:
    // "Avt_Test" in https://taseu.combtas.com/Avt_Test/... is the company Avt. The account is
    // created the first time a company is seen. Only for a contact with the customer's own email,
    // never the fallback contact, and never over an account the contact already has. Needs the
    // Desk.search.READ, Desk.contacts.READ and Desk.contacts.UPDATE scopes (see OAuth above) —
    // searching accounts needs BOTH of the first two (a token with only Desk.search.READ got 403
    // SCOPE_MISMATCH, 2026-10-05). false turns it off.
    "LinkContactAccount": true
  },

  // Chatbot page links (366 pages: nav menu, all Settings tabs, all Analysis Reports)
  // live in Data/page-links.json next to this file on the server — NOT here. It's a
  // plain data file (no secrets), so if production uses a different host/site-folder
  // than QA_3_70, just edit the "url" values directly in that file and restart the
  // app pool — no code change or redeploy needed.

  "Storage": {
    "Provider": "local",
    "LocalPath": "./storage"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  }
}
