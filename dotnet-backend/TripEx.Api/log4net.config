<?xml version="1.0" encoding="utf-8" ?>
<log4net>
  <!-- Daily-rolling file: <app>/logs/tripex-YYYYMMDD.log, keep 30 days, 50MB cap per file.
       %property{LogDir} is set in Program.cs to an ABSOLUTE path under the deploy folder,
       so the file location does not depend on the process working directory (which is
       C:\Windows\System32\inetsrv under IIS in-process hosting). A relative path here is
       why the log silently stopped updating once the app ran under IIS. -->
  <appender name="RollingFile" type="log4net.Appender.RollingFileAppender">
    <file type="log4net.Util.PatternString" value="%property{LogDir}\tripex-" />
    <appendToFile value="true" />
    <staticLogFileName value="false" />
    <rollingStyle value="Composite" />
    <datePattern value="yyyyMMdd'.log'" />
    <maxSizeRollBackups value="30" />
    <maximumFileSize value="50MB" />
    <preserveLogFileNameExtension value="true" />
    <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
    <encoding value="utf-8" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date{yyyy-MM-dd HH:mm:ss.fff zzz} [%-5level] %message%newline%exception" />
    </layout>
  </appender>

  <!-- NOTE: no ConsoleAppender here on purpose.
       Program.cs redirects Console.Out/Console.Error INTO log4net (logger "Console")
       so the app's Console.WriteLine lines land in the daily file. A ConsoleAppender
       would write those events back to Console.Out — i.e. back into log4net — creating
       a feedback loop that logged every line twice (the nested-duplicate lines seen in
       earlier logs). IIS captures real stdout separately via stdoutLogEnabled in web.config. -->

  <root>
    <level value="INFO" />
    <appender-ref ref="RollingFile" />
  </root>

  <!-- Quiet down framework noise -->
  <logger name="Microsoft.AspNetCore">
    <level value="WARN" />
  </logger>
  <logger name="Microsoft.EntityFrameworkCore">
    <level value="WARN" />
  </logger>

  <!-- ...but NOT the categories that carry request outcomes. ASP.NET Core emits every 400
       (model validation), 401 (authentication), 403 (authorization policy) and 404/405
       (routing) at Information — so the blanket Microsoft.AspNetCore=WARN above made this
       service physically incapable of logging any 4xx. Only a 500 left a trace (via the
       explicit Console.Error.WriteLine in ChatController's catch-all), which is why
       "there is no error in the log" was never evidence that a request succeeded.
       These are deliberately narrower than Microsoft.AspNetCore.* so we get request
       outcomes without the full framework firehose.

       Hosting.Diagnostics is NOT among them any more (Roi, 2026-10-05). Its "Request starting" /
       "Request finished" lines carry the full URL with the query string: the widget's
       conversation id (/api/chat/updates?sessionToken=..., every 6 seconds) and the Zoho
       webhook secret (a path segment of /api/zoho/desk/thread/...). Program.cs writes
       "[HTTP] <method> <path> <status> <elapsed>ms" for every request instead — path only, the
       webhook secret as ***. See RequestLog. -->
  <logger name="Microsoft.AspNetCore.Hosting.Diagnostics">
    <level value="WARN" />
  </logger>
  <logger name="Microsoft.AspNetCore.Authentication">
    <level value="INFO" />
  </logger>
  <logger name="Microsoft.AspNetCore.Authorization">
    <level value="INFO" />
  </logger>
  <logger name="Microsoft.AspNetCore.Mvc.Infrastructure">
    <level value="INFO" />
  </logger>

  <!-- Outgoing calls. IHttpClientFactory's own logger writes "Start processing HTTP request
       <method> <full URL>" for each one, query string included (.NET 8 does not redact it) — the
       Zoho account search carries the customer's company name there and the geolocation lookup
       the customer's IP address — and the root's INFO would let it through. The services log
       the outcome of their own calls ([OCI], [ZOHO]) and Milo's turn time ([CHAT] latency=);
       what goes is the per-call "Received HTTP response headers after Nms" line. -->
  <logger name="System.Net.Http.HttpClient">
    <level value="WARN" />
  </logger>
</log4net>
